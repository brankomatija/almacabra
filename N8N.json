    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"fecha\": {\n      \"type\": \"string\",\n      \"description\": \"Fecha de la noticia (AAAA-MM-DD).\"\n    },\n    \"pais\": {\n      \"type\": \"string\",\n      \"description\": \"País afectado por la regulación.\"\n    },\n    \"organismo\": {\n      \"type\": \"string\",\n      \"description\": \"Nombre del ente regulador (ej. IFT, CNMC, CRC).\"\n    },\n    \"tema\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Espectro Radioeléctrico\",\n        \"5G / 6G\",\n        \"Inteligencia Artificial\",\n        \"Ciberseguridad\",\n        \"Protección de Datos\",\n        \"Satélites\",\n        \"Competencia\",\n        \"Infraestructura\"\n      ],\n      \"description\": \"Categoría principal de la noticia.\"\n    },\n    \"resumen\": {\n      \"type\": \"string\",\n      \"description\": \"Resumen técnico de máximo 200 caracteres.\"\n    },\n    \"es_regulacion\": {\n      \"type\": \"boolean\",\n      \"description\": \"True si es sobre leyes/normas TIC, False si es noticia general.\"\n    }\n  },\n  \"required\": [\"pais\", \"tema\", \"resumen\", \"es_regulacion\"]\n}"
