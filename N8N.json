      "id": "f2960da1-afa4-4df7-a6b3-2f5620f2ff7e",
      "name": "Obtener JSON GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// 1. Obtenemos los datos del nodo anterior de forma segura\nconst allData = $input.all();\nlet feedsToProcess = [];\n\n// 2. Lista de países ampliada\nconst countriesOfInterest = [\n  'ESP', 'MEX', 'ARG', 'COL', 'CHL', 'PER', 'BOL', \n  'ECU', 'VEN', 'URY', 'PRY', 'PAN', 'CRI', 'GTM', \n  'HND', 'SLV', 'DOM', 'NIC', 'USA'\n];\n\n// 3. Procesamos cada item que venga del input (por si GitHub viene fragmentado)\nfor (const item of allData) {\n  const rawFeeds = item.json.data || item.json;\n  \n  if (!rawFeeds || typeof rawFeeds !== 'object') continue;\n\n  // 4. Mapeo de los feeds para cada país de la lista\n  for (const country of countriesOfInterest) {\n    if (rawFeeds[country] && Array.isArray(rawFeeds[country])) {\n      rawFeeds[country].forEach(feed => {\n        feedsToProcess.push({\n          json: { // Importante: Envolvemos en 'json' para que n8n lo reconozca como múltiples items\n            country_code: country,\n            publication: feed.publication_name,\n            url: feed.publication_rss_feed_uri\n          }\n        });\n      });\n    }\n  }\n}\n\n// 5. Retornamos la lista completa de items\nreturn feedsToProcess;"
      },
      "id": "93ef5776-8a88-4c07-9275-db070d4882c9",
